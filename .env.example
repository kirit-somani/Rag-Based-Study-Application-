OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama3  # or mistral

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Groq Configuration (Optional)
# Free tier at https://console.groq.com/keys - hosts Llama 3.x at very high speed.
# Uses an OpenAI-compatible endpoint, so no extra Python package is needed.
GROQ_API_KEY=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

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2 # options: all-MiniLM-L6-v2, BAAI/bge-small-en-v1.5
VECTOR_STORE=faiss # options: faiss, chroma
